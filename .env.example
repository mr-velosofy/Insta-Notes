# Discord webhook URL for the "video downloaded" notification.
# Leave empty to disable notifications entirely.
DISCORD_WEBHOOK_URL=

# Public site URL used for SEO tags, robots.txt, sitemap.xml and Discord
# embeds. Defaults to RENDER_EXTERNAL_URL on Render; set this explicitly only
# if you serve the app from a custom domain.
# SITE_URL=https://insta-notes.onrender.com
